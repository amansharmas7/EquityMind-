# Copy to .env. Never commit .env or paste API keys into GitHub.
APP_ENV=development
API_KEY=
DEMO_MODE=true

# Docker Compose uses this password for the local PostgreSQL service.
# Use an alphanumeric password to avoid URL-encoding issues.
POSTGRES_PASSWORD=equitymind-local-only
DATABASE_URL=postgresql://equitymind:equitymind-local-only@localhost:5432/equitymind
VECTOR_DIMENSIONS=1536

# Required for filing embeddings and grounded RAG answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# SEC EDGAR requires a descriptive User-Agent with a real contact email.
SEC_USER_AGENT=EquityMindResearchStudio/0.1 your-email@example.com

# Optional FinBERT (install: pip install -e '.[nlp]')
FINBERT_MODEL=ProsusAI/finbert
