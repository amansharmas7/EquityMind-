# EquityMind Research Studio - local development
# Keep this file private. Never commit .env or share API keys.

APP_ENV=development
API_KEY=
DEMO_MODE=true

# Local PostgreSQL + pgvector
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://equitymind:change-this-local-password@localhost:5432/equitymind

# Groq hosted chat model (free tier subject to Groq rate limits)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local CPU embeddings; no embedding API key or hosted embedding charges
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSIONS=384

# SEC EDGAR requires a descriptive User-Agent with a real contact email
SEC_USER_AGENT=EquityMindResearchStudio/0.1 your-real-email@example.com

# Optional FinBERT sentiment model
FINBERT_MODEL=ProsusAI/finbert
