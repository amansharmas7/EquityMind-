# Application
APP_ENV=development
API_KEY=
DEMO_MODE=true

# Database / RAG (install: pip install -e '.[database]')
DATABASE_URL=postgresql://equitymind:equitymind@localhost:5432/equitymind
VECTOR_DIMENSIONS=1536

# Optional LLM synthesis (install: pip install -e '.[agent]')
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# SEC EDGAR: provide a descriptive User-Agent with contact email
SEC_USER_AGENT=EquityMindResearchStudio/0.1 contact@example.com

# Optional FinBERT (install: pip install -e '.[nlp]')
FINBERT_MODEL=ProsusAI/finbert
